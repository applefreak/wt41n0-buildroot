# /etc/inittab for the WT41N0 (BusyBox init)
#
# Format: <id>::<action>:<process>   (<id> is the tty the process runs on)

# Early setup, as in Buildroot's default inittab
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname

# Start-up scripts (/etc/init.d/S*), quiet or verbose per /etc/default/wt41n0
::sysinit:/usr/sbin/wt41n0-rcS

# Root shell on the LCD + keypad, no login (see docs/customizing.md to add one)
tty1::respawn:-/bin/sh

# Root shell on the USB serial console, once a host has connected
::respawn:/usr/sbin/wt41n0-usb-console

# Shutdown
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
::shutdown:/usr/sbin/wt41n0-poweroff-radio

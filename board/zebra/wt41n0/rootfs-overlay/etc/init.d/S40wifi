#!/bin/sh
# Wi-Fi on wlan0 with wpa_supplicant and DHCP, and the clock from NTP. Networks come
# from /etc/wpa_supplicant.conf (the BSP's local/wifi.conf, or added with the
# Settings app); the build installs one without networks when there is no local one.
#
# A small supervisor runs in the background, so the boot does not wait for the
# network: it starts wpa_supplicant (and restarts it if it ever exits), runs the
# DHCP client, and keeps wpa_supplicant's ignore list empty while the link is
# down. Logs: /var/log/wifi.log (wpa_supplicant) and /var/log/messages (DHCP).
CONF=/etc/wpa_supplicant.conf
PIDDIR=/var/run
LOG=/var/log/wifi.log

supervise() {
	# wlan0 appears when the WL1283 firmware has loaded
	i=0; while [ ! -e /sys/class/net/wlan0 ] && [ $i -lt 30 ]; do sleep 1; i=$((i + 1)); done
	[ -e /sys/class/net/wlan0 ] || { echo "Wi-Fi: no wlan0" > /dev/kmsg; exit 1; }
	ip link set wlan0 up
	while :; do
		if ! pidof wpa_supplicant >/dev/null; then
			echo "--- $(cut -d' ' -f1 /proc/uptime)s starting wpa_supplicant" >> $LOG
			wpa_supplicant -i wlan0 -c "$CONF" >> $LOG 2>&1 &
			# DHCP client, once; it keeps retrying in the background on its own
			[ -f $PIDDIR/udhcpc.wlan0.pid ] ||
				udhcpc -S -i wlan0 -b -t 5 -T 3 -A 5 -p $PIDDIR/udhcpc.wlan0.pid >/dev/null 2>&1 &
			# network time; ntpd keeps retrying until the network is up
			pidof ntpd >/dev/null || ntpd -p pool.ntp.org
			sleep 2
			continue
		fi
		# Access points that do not answer are ignored for longer and longer;
		# with several of them in range the unit can sit in SCANNING for minutes.
		if wpa_cli -i wlan0 status 2>/dev/null | grep -q 'wpa_state=COMPLETED'; then
			sleep 10
		else
			wpa_cli -i wlan0 bssid_ignore clear >/dev/null 2>&1
			sleep 2
		fi
	done
}

start() {
	[ -s "$CONF" ] || { echo "Wi-Fi: not configured (no $CONF)"; return 0; }
	printf 'Starting Wi-Fi: '
	supervise </dev/null >/dev/null 2>&1 &
	echo $! > $PIDDIR/wifi-supervisor.pid
	echo OK
}

stop() {
	printf 'Stopping Wi-Fi: '
	[ -f $PIDDIR/wifi-supervisor.pid ] && kill "$(cat $PIDDIR/wifi-supervisor.pid)" 2>/dev/null
	[ -f $PIDDIR/udhcpc.wlan0.pid ] && kill "$(cat $PIDDIR/udhcpc.wlan0.pid)" 2>/dev/null
	killall wpa_supplicant 2>/dev/null
	rm -f $PIDDIR/wifi-supervisor.pid $PIDDIR/udhcpc.wlan0.pid
	ip link set wlan0 down 2>/dev/null
	echo OK
}

case "$1" in
start) start ;;
stop) stop ;;
restart) stop; sleep 1; start ;;
*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac

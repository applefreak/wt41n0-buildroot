 drivers/power/supply/Makefile         |   1 +
 drivers/power/supply/wt41n0-battery.c | 521 ++++++++++++++++++++++++++
 3 files changed, 530 insertions(+)
 create mode 100644 drivers/power/supply/wt41n0-battery.c


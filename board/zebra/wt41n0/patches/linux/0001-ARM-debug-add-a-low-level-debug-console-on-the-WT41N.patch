diff --git a/arch/arm/mach-omap2/io.c b/arch/arm/mach-omap2/io.c
index 14ec3f780..ac81e5247 100644
--- a/arch/arm/mach-omap2/io.c
+++ b/arch/arm/mach-omap2/io.c
@@ -345,6 +345,13 @@ void __init am33xx_map_io(void)
 #ifdef CONFIG_ARCH_OMAP4
 void __init omap4_map_io(void)
 {
+	/*
+	 * The WT41N0 LCD debug console is not inside the L3/L4 windows
+	 * below, so it needs the generic DEBUG_LL mapping, which the core
+	 * only creates for machines without a map_io callback.
+	 */
+	if (IS_ENABLED(CONFIG_DEBUG_WT41N0_LCD))
+		debug_ll_io_init();
 	iotable_init(omap44xx_io_desc, ARRAY_SIZE(omap44xx_io_desc));
 	omap_barriers_init();
 }
diff --git a/arch/arm/mm/mmu.c b/arch/arm/mm/mmu.c
index f5b7a16c5..527dfa8e3 100644
--- a/arch/arm/mm/mmu.c
+++ b/arch/arm/mm/mmu.c
@@ -1156,6 +1156,8 @@ void __init debug_ll_io_init(void)
 	map.pfn = __phys_to_pfn(map.pfn);
 	map.virtual &= PAGE_MASK;
 	map.length = PAGE_SIZE;
+	if (IS_ENABLED(CONFIG_DEBUG_WT41N0_LCD))
+		map.length = SZ_256K;	/* whole LCD framebuffer + state */
 	map.type = MT_DEVICE;
 	iotable_init(&map, 1);
 }
@@ -1456,7 +1458,11 @@ static void __init devicemaps_init(const struct machine_desc *mdesc)
 		mdesc->map_io();
 	else
 		debug_ll_io_init();
+	if (IS_ENABLED(CONFIG_DEBUG_WT41N0_LCD))
+		pr_info("wt41n0: map_io done\n");
 	fill_pmd_gaps();
+	if (IS_ENABLED(CONFIG_DEBUG_WT41N0_LCD))
+		pr_info("wt41n0: fill_pmd_gaps done\n");
 
 	/* Reserve fixed i/o space in VMALLOC region */
 	pci_reserve_io();
@@ -1789,13 +1795,19 @@ void __init paging_init(const struct machine_desc *mdesc)
 	devicemaps_init(mdesc);
 	kmap_init();
 	tcm_init();
+	if (IS_ENABLED(CONFIG_DEBUG_WT41N0_LCD))
+		pr_info("wt41n0: kmap/tcm done\n");
 
 	top_pmd = pmd_off_k(0xffff0000);
 

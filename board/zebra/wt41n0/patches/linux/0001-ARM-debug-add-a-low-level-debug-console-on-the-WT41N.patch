From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Poyu Chen <me@poyu.xyz>
Date: Fri, 6 Nov 2026 06:01:43 +0000
Subject: [PATCH] ARM: debug: add a low-level debug console on the WT41N0 LCD

The WT41N0 has no reachable UART. Draw DEBUG_LL and earlyprintk output as
text into the framebuffer the bootloader leaves running (0x9B000000,
240x320 RGB565, rotated), so the kernel can be followed from the
decompressor on. Only the debug boot profile of the BSP enables it.

Upstream: not submitted (board-specific debug aid)
---
 arch/arm/Kconfig.debug              |  10 +-
 arch/arm/include/debug/wt41n0-lcd.S | 232 ++++++++++++++++++++++++++++
 arch/arm/mach-omap2/io.c            |   7 +
 arch/arm/mm/mmu.c                   |  12 ++
 4 files changed, 260 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/include/debug/wt41n0-lcd.S

diff --git a/arch/arm/Kconfig.debug b/arch/arm/Kconfig.debug
index 7f47b4f33..0874e8cd1 100644
--- a/arch/arm/Kconfig.debug
+++ b/arch/arm/Kconfig.debug
@@ -744,6 +744,13 @@ choice
 		depends on ARCH_OMAP2PLUS
 		select DEBUG_UART_8250
 
+	config DEBUG_WT41N0_LCD
+		bool "Kernel low-level debugging messages on the Zebra WT41N0 LCD"
+		depends on ARCH_OMAP2PLUS
+		help
+		  Draw low-level debug output as text into the LCD framebuffer
+		  at 0x9B000000 left running by the WT41N0 Symbol bootloader.
+
 	config DEBUG_OMAP4UART4
 		bool "Kernel low-level debugging messages via OMAP4/5 UART4"
 		depends on ARCH_OMAP2PLUS
@@ -1476,6 +1483,7 @@ config DEBUG_UART_FLOW_CONTROL
 config DEBUG_LL_INCLUDE
 	string
 	default "debug/sa1100.S" if DEBUG_SA1100
+	default "debug/wt41n0-lcd.S" if DEBUG_WT41N0_LCD
 	default "debug/palmchip.S" if DEBUG_UART_8250_PALMCHIP
 	default "debug/8250.S" if DEBUG_LL_UART_8250 || DEBUG_UART_8250
 	default "debug/at91.S" if DEBUG_AT91_UART
@@ -1800,7 +1808,7 @@ config DEBUG_UART_8250_PALMCHIP
 
 config DEBUG_UNCOMPRESS
 	bool "Enable decompressor debugging via DEBUG_LL output"
-	depends on !ARCH_MULTIPLATFORM
+	depends on !ARCH_MULTIPLATFORM || DEBUG_WT41N0_LCD
 	depends on !(ARCH_FOOTBRIDGE || ARCH_RPC || ARCH_SA1100)
 	depends on DEBUG_LL && !DEBUG_OMAP2PLUS_UART && \
 		     (!DEBUG_TEGRA_UART || !ZBOOT_ROM) && \
diff --git a/arch/arm/include/debug/wt41n0-lcd.S b/arch/arm/include/debug/wt41n0-lcd.S
new file mode 100644
index 000000000..19d5bc022
--- /dev/null
+++ b/arch/arm/include/debug/wt41n0-lcd.S
@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Low-level debug "UART" for the Zebra WT41N0 that draws text straight
+ * into the LCD framebuffer left running by the Symbol bootloader.
+ *
+ * Framebuffer: 0x9B000000, 240x320 RGB565, 480-byte stride, scanned out
+ * rotated so that physical (x,y) = memory (319-y... see below). Text is laid
+ * out in the physical orientation: 40 columns x 30 rows of 8x8 cells.
+ *   memory_x = physical_y,  memory_y = 319 - physical_x
+ * Cell (col c, row r), glyph pixel (gx, gy):
+ *   address = fb + (319 - 8c - gx) * 480 + (8r + gy) * 2
+ *
+ * A small state block lives right after the framebuffer (fb + 0x25800):
+ *   +0 col, +4 row, +8.. saved r4-r9. No stack is used, because printascii
+ * can be called before one exists. The DTS reserves 256 KiB at 0x9B000000.
+ * With the MMU on the kernel maps the same 256 KiB at 0xFB000000 (see
+ * debug_ll_io_init).
+ *
+ * Every character is drawn as a full cell: white on black. A newline clears
+ * the next two rows, so the row after the cursor is always blank; output
+ * wraps from the bottom row back to the top.
+ */
+
+#define WT41N0_LCD_PHYS		0x9B000000
+#define WT41N0_LCD_VIRT		0xFB000000
+#define WT41N0_LCD_STATE	0x25800
+
+		.macro	addruart, rp, rv, tmp
+		mov	\rp, #WT41N0_LCD_PHYS		@ 0x9B << 24: plain immediate
+		mov	\rv, #WT41N0_LCD_VIRT		@ 0xFB << 24
+		.endm
+
+		.macro	senduart, rd, rx
+		add	\rx, \rx, #WT41N0_LCD_STATE
+		str	r4, [\rx, #8]
+		str	r5, [\rx, #12]
+		str	r6, [\rx, #16]
+		str	r7, [\rx, #20]
+		str	r8, [\rx, #24]
+		str	r9, [\rx, #28]
+		ldr	r4, [\rx, #0]			@ column
+		ldr	r5, [\rx, #4]			@ row
+		cmp	r4, #39
+		cmpls	r5, #29
+		movhi	r4, #0				@ uninitialised: start top-left
+		movhi	r5, #0
+		and	r6, \rd, #0xff
+		cmp	r6, #10
+		beq	7001f				@ newline
+		cmp	r6, #13
+		beq	7009f				@ carriage return: ignore
+		sub	r6, r6, #32
+		cmp	r6, #94
+		movhi	r6, #31				@ '?' for non-printable
+		adr	r7, 7008f
+		add	r7, r7, r6, lsl #3		@ glyph
+		mov	r6, #320
+		sub	r6, r6, #1			@ 319 (not a valid immediate)
+		sub	r6, r6, r4, lsl #3		@ 319 - 8*col
+		mov	r8, #480
+		mul	r6, r6, r8
+		sub	r8, \rx, #WT41N0_LCD_STATE
+		add	r6, r6, r8
+		add	r6, r6, r5, lsl #4		@ + 16*row  (8*row pixels)
+		mov	r8, #0				@ gy
+7002:		ldrb	r9, [r7, r8]
+		add	r4, r6, r8, lsl #1		@ pixel pointer, gx = 0
+		mov	r5, #8
+7003:		tst	r9, #0x80
+		moveq	\rd, #0
+		movne	\rd, #0xff
+		orrne	\rd, \rd, #0xff00
+		strh	\rd, [r4]
+		sub	r4, r4, #480			@ next gx
+		lsl	r9, r9, #1
+		subs	r5, r5, #1
+		bne	7003b
+		add	r8, r8, #1
+		cmp	r8, #8
+		blo	7002b
+		ldr	r4, [\rx, #0]
+		ldr	r5, [\rx, #4]
+		cmp	r4, #39
+		cmpls	r5, #29
+		movhi	r4, #0
+		movhi	r5, #0
+		add	r4, r4, #1
+		cmp	r4, #40
+		blo	7009f
+7001:		mov	r4, #0
+		add	r5, r5, #1
+		cmp	r5, #30
+		movhs	r5, #0
+		mov	r8, #2				@ clear this row and the next
+		mov	r9, r5
+7004:		sub	r6, \rx, #WT41N0_LCD_STATE
+		add	r6, r6, r9, lsl #4
+		mov	r7, #320
+		mov	\rd, #0
+7005:		str	\rd, [r6]
+		str	\rd, [r6, #4]
+		str	\rd, [r6, #8]
+		str	\rd, [r6, #12]
+		add	r6, r6, #480
+		subs	r7, r7, #1
+		bne	7005b
+		add	r9, r9, #1
+		cmp	r9, #30
+		movhs	r9, #0
+		subs	r8, r8, #1
+		bne	7004b
+7009:		str	r4, [\rx, #0]
+		str	r5, [\rx, #4]
+		ldr	r4, [\rx, #8]
+		ldr	r5, [\rx, #12]
+		ldr	r6, [\rx, #16]
+		ldr	r7, [\rx, #20]
+		ldr	r8, [\rx, #24]
+		ldr	r9, [\rx, #28]
+		sub	\rx, \rx, #WT41N0_LCD_STATE
+		b	7010f
+		.balign	4
+7008:
+	.byte	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00	@ ' '
+	.byte	0x18, 0x3c, 0x3c, 0x18, 0x18, 0x00, 0x18, 0x00	@ '!'
+	.byte	0x66, 0x66, 0x24, 0x00, 0x00, 0x00, 0x00, 0x00	@ '"'
+	.byte	0x6c, 0x6c, 0xfe, 0x6c, 0xfe, 0x6c, 0x6c, 0x00	@ '#'
+	.byte	0x18, 0x3e, 0x60, 0x3c, 0x06, 0x7c, 0x18, 0x00	@ '$'
+	.byte	0x00, 0xc6, 0xcc, 0x18, 0x30, 0x66, 0xc6, 0x00	@ '%'
+	.byte	0x38, 0x6c, 0x38, 0x76, 0xdc, 0xcc, 0x76, 0x00	@ '&'
+	.byte	0x18, 0x18, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00	@ "'"
+	.byte	0x0c, 0x18, 0x30, 0x30, 0x30, 0x18, 0x0c, 0x00	@ '('
+	.byte	0x30, 0x18, 0x0c, 0x0c, 0x0c, 0x18, 0x30, 0x00	@ ')'
+	.byte	0x00, 0x66, 0x3c, 0xff, 0x3c, 0x66, 0x00, 0x00	@ '*'
+	.byte	0x00, 0x18, 0x18, 0x7e, 0x18, 0x18, 0x00, 0x00	@ '+'
+	.byte	0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x30	@ ','
+	.byte	0x00, 0x00, 0x00, 0x7e, 0x00, 0x00, 0x00, 0x00	@ '-'
+	.byte	0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x00	@ '.'
+	.byte	0x06, 0x0c, 0x18, 0x30, 0x60, 0xc0, 0x80, 0x00	@ '/'
+	.byte	0x38, 0x6c, 0xc6, 0xd6, 0xc6, 0x6c, 0x38, 0x00	@ '0'
+	.byte	0x18, 0x38, 0x18, 0x18, 0x18, 0x18, 0x7e, 0x00	@ '1'
+	.byte	0x7c, 0xc6, 0x06, 0x1c, 0x30, 0x66, 0xfe, 0x00	@ '2'
+	.byte	0x7c, 0xc6, 0x06, 0x3c, 0x06, 0xc6, 0x7c, 0x00	@ '3'
+	.byte	0x1c, 0x3c, 0x6c, 0xcc, 0xfe, 0x0c, 0x1e, 0x00	@ '4'
+	.byte	0xfe, 0xc0, 0xc0, 0xfc, 0x06, 0xc6, 0x7c, 0x00	@ '5'
+	.byte	0x38, 0x60, 0xc0, 0xfc, 0xc6, 0xc6, 0x7c, 0x00	@ '6'
+	.byte	0xfe, 0xc6, 0x0c, 0x18, 0x30, 0x30, 0x30, 0x00	@ '7'
+	.byte	0x7c, 0xc6, 0xc6, 0x7c, 0xc6, 0xc6, 0x7c, 0x00	@ '8'
+	.byte	0x7c, 0xc6, 0xc6, 0x7e, 0x06, 0x0c, 0x78, 0x00	@ '9'
+	.byte	0x00, 0x18, 0x18, 0x00, 0x00, 0x18, 0x18, 0x00	@ ':'
+	.byte	0x00, 0x18, 0x18, 0x00, 0x00, 0x18, 0x18, 0x30	@ ';'
+	.byte	0x06, 0x0c, 0x18, 0x30, 0x18, 0x0c, 0x06, 0x00	@ '<'
+	.byte	0x00, 0x00, 0x7e, 0x00, 0x00, 0x7e, 0x00, 0x00	@ '='
+	.byte	0x60, 0x30, 0x18, 0x0c, 0x18, 0x30, 0x60, 0x00	@ '>'
+	.byte	0x7c, 0xc6, 0x0c, 0x18, 0x18, 0x00, 0x18, 0x00	@ '?'
+	.byte	0x7c, 0xc6, 0xde, 0xde, 0xde, 0xc0, 0x78, 0x00	@ '@'
+	.byte	0x38, 0x6c, 0xc6, 0xfe, 0xc6, 0xc6, 0xc6, 0x00	@ 'A'
+	.byte	0xfc, 0x66, 0x66, 0x7c, 0x66, 0x66, 0xfc, 0x00	@ 'B'
+	.byte	0x3c, 0x66, 0xc0, 0xc0, 0xc0, 0x66, 0x3c, 0x00	@ 'C'
+	.byte	0xf8, 0x6c, 0x66, 0x66, 0x66, 0x6c, 0xf8, 0x00	@ 'D'
+	.byte	0xfe, 0x62, 0x68, 0x78, 0x68, 0x62, 0xfe, 0x00	@ 'E'
+	.byte	0xfe, 0x62, 0x68, 0x78, 0x68, 0x60, 0xf0, 0x00	@ 'F'
+	.byte	0x3c, 0x66, 0xc0, 0xc0, 0xce, 0x66, 0x3a, 0x00	@ 'G'
+	.byte	0xc6, 0xc6, 0xc6, 0xfe, 0xc6, 0xc6, 0xc6, 0x00	@ 'H'
+	.byte	0x3c, 0x18, 0x18, 0x18, 0x18, 0x18, 0x3c, 0x00	@ 'I'
+	.byte	0x1e, 0x0c, 0x0c, 0x0c, 0xcc, 0xcc, 0x78, 0x00	@ 'J'
+	.byte	0xe6, 0x66, 0x6c, 0x78, 0x6c, 0x66, 0xe6, 0x00	@ 'K'
+	.byte	0xf0, 0x60, 0x60, 0x60, 0x62, 0x66, 0xfe, 0x00	@ 'L'
+	.byte	0xc6, 0xee, 0xfe, 0xfe, 0xd6, 0xc6, 0xc6, 0x00	@ 'M'
+	.byte	0xc6, 0xe6, 0xf6, 0xde, 0xce, 0xc6, 0xc6, 0x00	@ 'N'
+	.byte	0x7c, 0xc6, 0xc6, 0xc6, 0xc6, 0xc6, 0x7c, 0x00	@ 'O'
+	.byte	0xfc, 0x66, 0x66, 0x7c, 0x60, 0x60, 0xf0, 0x00	@ 'P'
+	.byte	0x7c, 0xc6, 0xc6, 0xc6, 0xc6, 0xce, 0x7c, 0x0e	@ 'Q'
+	.byte	0xfc, 0x66, 0x66, 0x7c, 0x6c, 0x66, 0xe6, 0x00	@ 'R'
+	.byte	0x3c, 0x66, 0x30, 0x18, 0x0c, 0x66, 0x3c, 0x00	@ 'S'
+	.byte	0x7e, 0x7e, 0x5a, 0x18, 0x18, 0x18, 0x3c, 0x00	@ 'T'
+	.byte	0xc6, 0xc6, 0xc6, 0xc6, 0xc6, 0xc6, 0x7c, 0x00	@ 'U'
+	.byte	0xc6, 0xc6, 0xc6, 0xc6, 0xc6, 0x6c, 0x38, 0x00	@ 'V'
+	.byte	0xc6, 0xc6, 0xc6, 0xd6, 0xd6, 0xfe, 0x6c, 0x00	@ 'W'
+	.byte	0xc6, 0xc6, 0x6c, 0x38, 0x6c, 0xc6, 0xc6, 0x00	@ 'X'
+	.byte	0x66, 0x66, 0x66, 0x3c, 0x18, 0x18, 0x3c, 0x00	@ 'Y'
+	.byte	0xfe, 0xc6, 0x8c, 0x18, 0x32, 0x66, 0xfe, 0x00	@ 'Z'
+	.byte	0x3c, 0x30, 0x30, 0x30, 0x30, 0x30, 0x3c, 0x00	@ '['
+	.byte	0xc0, 0x60, 0x30, 0x18, 0x0c, 0x06, 0x02, 0x00	@ '\\'
+	.byte	0x3c, 0x0c, 0x0c, 0x0c, 0x0c, 0x0c, 0x3c, 0x00	@ ']'
+	.byte	0x10, 0x38, 0x6c, 0xc6, 0x00, 0x00, 0x00, 0x00	@ '^'
+	.byte	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xff	@ '_'
+	.byte	0x30, 0x18, 0x0c, 0x00, 0x00, 0x00, 0x00, 0x00	@ '`'
+	.byte	0x00, 0x00, 0x78, 0x0c, 0x7c, 0xcc, 0x76, 0x00	@ 'a'
+	.byte	0xe0, 0x60, 0x7c, 0x66, 0x66, 0x66, 0xdc, 0x00	@ 'b'
+	.byte	0x00, 0x00, 0x7c, 0xc6, 0xc0, 0xc6, 0x7c, 0x00	@ 'c'
+	.byte	0x1c, 0x0c, 0x7c, 0xcc, 0xcc, 0xcc, 0x76, 0x00	@ 'd'

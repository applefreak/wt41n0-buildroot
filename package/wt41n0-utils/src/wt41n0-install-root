#!/bin/sh
# wt41n0-install-root: write the root filesystem image to the eMMC root partition
# (201 MiB to the end, over the Windows CE Application/Platform/Scratchpad areas).
# Run it from the RAM system. Normally driven by support/install.py on the host.
#
#   wt41n0-install-root --yes < stream
#
# The stream is one header line "WT41N0ROOT <bytes> <sha256>" (size and checksum of
# the uncompressed image) followed by the gzip-compressed image. Nothing below
# 201 MiB is written: the boot chain, the OS area and Application's first sector
# (which the bootloader checks) stay as they are.
set -eu
DEV=/dev/mmcblk1
START_MIB=201
PART_MIB=1687
die() { echo "wt41n0-install-root: $*" >&2; exit 1; }
u32() { hexdump -s "$2" -n 4 -e '1/4 "%u"' "$1"; }

[ "${1:-}" = --yes ] || die "this erases the Windows CE data partitions; pass --yes"
grep -q '^/dev/mmcblk1p1 / ' /proc/mounts && die "run this from the RAM or recovery system, not from the eMMC system"
grep -q '^/dev/mmcblk1p' /proc/mounts && die "an eMMC partition is mounted"

# The expected eMMC: Toshiba 004G60 configured as 1888 MiB
[ "$(cat /sys/block/mmcblk1/device/name)" = 004G60 ] || die "unexpected eMMC $(cat /sys/block/mmcblk1/device/name)"
[ "$(cat /sys/block/mmcblk1/size)" = 3866624 ] || die "unexpected eMMC size"

# Symbol partition table: Application at 200 MiB, its first sector intact
tab=/tmp/install-root.tab
dd if=$DEV of=$tab bs=4096 skip=768 count=1 2>/dev/null
[ "$(dd if=$tab bs=1 skip=$((0x12c)) count=11 2>/dev/null)" = Application ] || die "no Application entry in the partition table"
[ "$(u32 $tab $((0x12c + 36)))" = $((200 * 2048)) ] || die "Application does not start at 200 MiB"
rm -f $tab
[ "$(dd if=$DEV bs=1 skip=$((200 * 1048576 + 510)) count=2 2>/dev/null | hexdump -e '2/1 "%02x"')" = 55aa ] ||
	die "the Application boot sector at 200 MiB is not intact"

read -r magic size sha
[ "$magic" = WT41N0ROOT ] || die "bad stream header"
[ "$size" -le $((PART_MIB * 1048576)) ] || die "image ($size bytes) larger than the $PART_MIB MiB partition"

echo "wt41n0-install-root: writing $size bytes at $START_MIB MiB"
gunzip -c | head -c "$size" | dd of=$DEV bs=1M seek=$START_MIB conv=fsync 2>/dev/null
sync
echo 3 > /proc/sys/vm/drop_caches
echo "wt41n0-install-root: verifying"
got=$(dd if=$DEV bs=1M skip=$START_MIB count=$(( (size + 1048575) / 1048576 )) 2>/dev/null | head -c "$size" | sha256sum | cut -d' ' -f1)
[ "$got" = "$sha" ] || die "verification FAILED (got $got)"
echo "wt41n0-install-root: root filesystem written and verified"

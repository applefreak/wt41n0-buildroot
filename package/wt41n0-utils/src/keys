#!/bin/sh
# Keypad layers of the WT41N0 console keymap (generated by support/keymap.py).
cat <<'TXT'
WT41N0 keypad layers. A colour key applies to the NEXT key;
press it twice to lock, once more to unlock.

  ORANGE then key   orange letter on the key
  GRAY then key     gray letter on the key
  ORANGE + GRAY     punctuation  ! @ # $ % ^ & * ( ) = [ ] _ | ,
  BLUE then key     blue legend: space, F1..F10, left/right

  SPACE/BKSP        backspace          ALT/CTRL (held)   Ctrl
  P1  /   (gray |)                     P2  .   (gray ,)
  MENU/TAB          Tab   (orange -   gray *   orange+gray _)
  arrow keys        up / down          ESC, ENTER as labelled
TXT

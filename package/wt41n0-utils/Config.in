config BR2_PACKAGE_WT41N0_UTILS
	bool "wt41n0-utils"
	help
	  Small board tools for the WT41N0:

	    pcmtest         play a test tone or record, straight through
	                    the kernel PCM interface (no ALSA library)
	    wt41n0-fpga     FPGA registers, touch pen level, accessory power
	    wt41n0-survey   collect logs and hardware state (read-only)
	    wt41n0-update   install a new image into the eMMC OS area
	    wt41n0-install-root  write the root filesystem to the eMMC
	    wt41n0-growfs   grow the eMMC root file system to its partition
	    wt41n0-scan     read barcodes from the ring scanner
	    keys            show the keypad layers
